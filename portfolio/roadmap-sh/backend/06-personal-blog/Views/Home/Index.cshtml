@model IEnumerable<BlogPost>
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">Bienvenido a mi blog personal</h1>

    @if(Model.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.PostTitle)</th>
                    <th>@Html.DisplayNameFor(model => model.PublicationDate)</th>
                </tr>
            </thead>
            <tbody>
                @foreach(BlogPost p in Model)
                {
                    <tr>
                        <td><a asp-action="Post" asp-controller="Blog" asp-route-id="@p.Id">@Html.DisplayFor(modelPost => p.PostTitle)</a></td>
                        <td>@Html.DisplayFor(modelPost => p.PublicationDate)</td>
                    </tr>
                }
            </tbody>
        </table>
        <a asp-action="Index" asp-controller="Blog" class="btn btn-primary">Vee todas mis publicaciones!</a>
    }
    else
    {
        <h2>Parece que aun no hay ningún post</h2>
    }
</div>
