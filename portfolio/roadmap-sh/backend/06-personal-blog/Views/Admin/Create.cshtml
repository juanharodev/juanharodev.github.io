@model BlogPost

@{
    ViewData["title"] = "Crear";
}
<div>
    <a asp-action="index">Regresar al panel de administración</a>
</div>
<hr>
<h1>Crear</h1>
<hr>
<h2>Nueva publicación</h2>

<div>
    <form asp-action="Create">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="PostTitle" class="control-label">Titulo del articulo</label>
            <input asp-for="PostTitle" class="form-control">
        </div>
        <br>
        <div class="form-group">
            <label asp-for="PublicationDate" class="control-label">Fecha de publicación</label>
            <input asp-for="PublicationDate" class="form-control">
            <span asp-validation-for="PublicationDate" class="text-danger"></span>
        </div>
        <br>
        <div class="form-group">
            <label asp-for="Content" class="control-label">Contenido</label>
            <textarea asp-for="Content" class="form-control" style="min-height: 200px;"></textarea>
        </div>
        <br>
        <div class="form-group">
            <button class="btn btn-primary">Crear</button>
        </div>
    </form>
</div>

@section Scripts{
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}